# ---- server ----
PORT=3001
# Comma-separated allowed origins when the client is hosted on another domain (default: *)
CORS_ORIGIN=
# Where leaderboard.json is stored (use a persistent volume in production)
DATA_DIR=
# ---- client (build time) ----
# URL of the multiplayer server when the client is hosted separately (default: same origin)
VITE_SERVER_URL=
# Base path, e.g. /jsjd/ for a GitHub Pages project site
VITE_BASE=
